# 온통청년(청년정책 통합정보) Open API 인증키 — 청년 대상
# 발급: https://www.youthcenter.go.kr 로그인 > 마이페이지 > OPEN API > 인증키 신청 (담당자 승인 필요)
YOUTH_API_KEY=

# 복지로(한국사회보장정보원) 중앙부처복지서비스 API 인증키 — 노인/중장년/청년/학생 등 전 생애주기
# 발급: https://www.data.go.kr 로그인 > 데이터셋 "한국사회보장정보원_중앙부처복지서비스" 검색 > 활용신청
BOKJIRO_API_KEY=

# 서버 포트 (Flutter 앱 기본값과 맞추려면 8787 유지)
PORT=8787
